# Clé secrète Flask (obligatoire). Génère-en une avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Base de données (par défaut : instance/teacards.db)
DATABASE_URL=sqlite:///teacards.db

# Délai (en secondes) avant que les paquets se rechargent
PACK_COOLDOWN_SECONDS=10

# Compte admin protégé (ne peut être ni rétrogradé ni supprimé)
PROTECTED_ADMIN_USERNAME=vain

# Mode debug (1 pour activer, uniquement en local)
FLASK_DEBUG=0
